extends SceneTree

var failures: Array[String] = []

func check(ok: bool, message: String) -> void:
	if not ok:
		failures.append(message)
		printerr("FAIL: ", message)

func _initialize() -> void:
	if not FileAccess.file_exists("res://addons/strategic_map_editor/document.gd"):
		printerr("RED: document model is not implemented")
		quit(1)
		return
	var script = load("res://addons/strategic_map_editor/document.gd")
	if not script or not script.can_instantiate():
		printerr("FAIL: model cannot compile")
		quit(1)
		return
	var doc = script.new()
	var original: String = JSON.stringify(doc.data)
	var id: String = doc.add_feature("city", [[200, 400]], "试城")
	check(not id.is_empty(), "add a city")
	check(doc.undo() and JSON.stringify(doc.data) == original, "undo restores document")
	check(doc.redo() and doc.find_feature(id).name == "试城", "redo restores stable id")
	check(doc.update_feature(id, {"name": "新城"}), "rename")
	check(doc.undo() and doc.find_feature(id).name == "试城", "undo rename")
	doc.add_feature("label", [[400, 200]], "河谷")
	check(not doc.redo(), "new action clears redo")
	var snapshot: Dictionary = doc.snapshot()
	snapshot.features[0].name = "polluted"
	check(doc.data.features[0].name != "polluted", "snapshot isolates references")
	var saved: String = JSON.stringify(doc.data)
	check(not doc.load_text('{"schema_version":900}').is_empty(), "reject future schema")
	check(JSON.stringify(doc.data) == saved, "invalid load preserves document")
	check(not doc.load_text('{bad json').is_empty(), "reject broken json")
	check(not doc.update_feature(id, {"points": [[-2, 5]]}), "reject off-map positions")
	var bad: Dictionary = doc.snapshot()
	bad.features.append(bad.features[0].duplicate(true))
	check(not doc.validate(bad).is_empty(), "reject duplicate ids")
	bad = doc.snapshot()
	bad.features[0].points = [["bad", 1]]
	check(not doc.validate(bad).is_empty(), "reject nonnumeric point")
	bad = doc.snapshot()
	bad.features[0].kind = "script"
	check(not doc.validate(bad).is_empty(), "reject unknown geometry kind")
	check(doc.save_file("user://contract_test.map.json").is_empty(), "save")
	check(not doc.is_dirty(), "save clears dirty state")
	var other = script.new()
	check(other.load_file("user://contract_test.map.json").is_empty(), "reload")
	check(JSON.parse_string(JSON.stringify(other.data)) == JSON.parse_string(JSON.stringify(doc.data)), "save/load preserves JSON values")
	check(other.validate(other.tongguan_sample()).is_empty(), "sample validates")
	other.replace_document(other.tongguan_sample())
	check(not other.remove_feature("tongguan"), "cannot silently delete a gate bound by a corridor")
	check(not other.update_feature("tongguan", {"kind":"city"}), "reject invalid gate reference")
	var nav = load("res://addons/strategic_map_editor/route_preview.gd").new()
	var start := Vector2(250, 430)
	var end := Vector2(1330, 430)
	var result: Dictionary = nav.solve(other.data, start, end, "army", false)
	check(result.ok, "open pass connects both sides")
	other.update_feature("tongguan", {"gate_open": false})
	result = nav.solve(other.data, start, end, "army", true)
	check(not result.ok, "closed gate blocks army even when trail is known")
	result = nav.solve(other.data, start, end, "light", false)
	check(not result.ok, "unknown secret trail unavailable")
	result = nav.solve(other.data, start, end, "light", true)
	check(result.ok, "known secret trail allows light squad")
	check(not nav.solve(other.data, Vector2(-1, 20), end, "army", false).ok, "reject off-map endpoints")
	check(not nav.solve(other.data, Vector2(810, 800), end, "light", true).ok, "light squad cannot climb arbitrary high mountain")
	other.update_feature("tongguan", {"gate_open": true})
	other.set_layer("sites", "visible", false)
	other.update_feature("tongguan", {"gate_open": false})
	check(not nav.solve(other.data, start, end, "army", false).ok, "hidden art layer cannot grant passage")
	other.set_layer("terrain", "locked", true)
	check(not other.remove_feature("qinling"), "locked layer blocks deletion")
	check(not other.update_feature("qinling", {"name":"改变"}), "locked layer blocks edit")
	check(other.add_feature("mountain", [[10,10],[80,10],[80,80]], "").is_empty(), "locked layer blocks drawing")
	var water_doc = script.new()
	water_doc.add_feature("water", [[760,0],[840,0],[840,960],[760,960]], "大河")
	var crossing: String = water_doc.add_feature("valley", [[700,430],[900,430]], "谷道")
	check(not nav.solve(water_doc.data, start, end, "army", false).ok, "valley cannot silently bridge water")
	water_doc.update_feature(crossing, {"kind":"crossing"})
	check(nav.solve(water_doc.data, start, end, "army", false).ok, "explicit crossing permits river transit")
	var thin = script.new()
	thin.add_feature("mountain",[[803,0],[804,0],[804,960],[803,960]],"极窄屏障")
	check(not nav.solve(thin.data,start,end,"army",false).ok,"thin barrier cannot produce a false positive route")
	print("DOCUMENT_AND_ROUTE: ", "PASS" if failures.is_empty() else "FAIL", " failures=", failures.size())
	quit(0 if failures.is_empty() else 1)
