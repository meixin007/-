        "title": "便殿御前三问《平戎策》",
        "rounds": [
          {
            "prompt": "第一问【贼军虚实】：“安贼窃据两京，贼势看似浩大，子美间道而来，观贼气象如何？”",
            "choices": [
              {
                "id": "choice_dufu_1_insight",
                "text": "【剖析根本】贼军杂合蕃汉，所过剽掠，民心不附；唯恃悍将骁骑，师老必弊。",
                "score": 30,
                "emperor_reply": "卿洞若观火，见识卓绝！"
              },
              {
                "id": "choice_dufu_1_cautious",
                "text": "【力主固守】贼军势盛，宜暂避锋芒，保全关陕，待四方勤王毕集再图收复。",
                "score": 15,
                "emperor_reply": "老成之见，稳扎稳打。"
              },
              {
                "id": "choice_dufu_1_radical",
                "text": "【急于决战】速借回纥之兵，直捣范阳老巢，贼军不战自乱。",
                "score": 5,
                "emperor_reply": "引狼入室，恐生后患。"
              }
            ]
          },
          {
            "prompt": "第二问【流民生计】：“关中大乱，黎庶流离，行在粮饷日蹙，当何以安民固本？”",
            "choices": [
              {
                "id": "choice_dufu_2_compassion",
                "text": "【体恤农桑】罢苛捐，开仓赈饥，招抚流民于汉南、剑南屯田，抚伤恤死。",
                "score": 35,
                "emperor_reply": "仁者爱人，此真匡扶黎庶之仁言！"
              },
              {
                "id": "choice_dufu_2_fiscal",
                "text": "【强征助饷】按户籍抽丁充军，令关东豪商按资出粟，以济行在。",
                "score": 10,
                "emperor_reply": "虽解燃眉之急，然伤民心。"
              }
            ]
          },
          {
            "prompt": "第三问【言路风宪】：“朝野多疑，宰辅互掣，朕欲整饬朝纲，卿何以教朕？”",
            "choices": [
              {
                "id": "choice_dufu_3_remonstrance",
                "text": "【广开言路】设立言官供奉，虚怀纳谏，绝内侍专横，则朝廷清明、将士效死。",
                "score": 35,
                "emperor_reply": "善！朕正需卿这般直言极谏之臣！"
              },
              {
                "id": "choice_dufu_3_flattery",
                "text": "【雷霆独断】乾纲独断，凡有异见者一律严惩，以定尊卑。",
                "score": 0,
                "emperor_reply": "此非长治久安之道。"
              }
            ]
          }
        ]
      }
