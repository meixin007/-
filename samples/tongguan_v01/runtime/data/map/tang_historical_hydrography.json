{
  "version": "1.0",
  "historical_era": "tang_tianbao_zhide",
  "description": "唐代天宝/至德年间水系考据，含对现代数据的历史修正。用于在地形高度场上刻蚀河道（下切），并作为地图河网与漕运走廊的依据。坐标一律为 [lon, lat]（先经后纬，WGS84）。",
  "conventions": {
    "coordinate_order": "[lon, lat]",
    "crs": "WGS84 / EPSG:4326",
    "bed_elevation_m": "与 path 逐点对应的河床高程（米），用于地形下切时插值",
    "carve_depth_m": "在河床高程基础上继续下切的深度，用于形成可见河谷",
    "channel_width_m": "河道在地形上的刻蚀半宽（米）"
  },
  "sources": [
    "谭其骧《中国历史地图集》第五册（隋唐五代十国）—— 河道走向与湖泊范围以此为准",
    "《元和郡县图志》（李吉甫，813）—— 州府道里与津渡",
    "《水经注》（郦道元）—— 汉唐故道走向参照",
    "《旧唐书·地理志》《新唐书·地理志》—— 州县沿革",
    "《通典·州郡典》《通典·食货典·漕运》—— 大运河四段"
  ],
  "critical_corrections": [
    {
      "target": "黄河下游",
      "issue": "现代黄河自 1855 年铜瓦厢决口后改走山东东营入海。唐代走「汉唐故道」：孟津—滑州—魏州—博州—棣州，于沧州/无棣一带入渤海，比现代河道偏北约 200 公里。",
      "impact": "若照抄现代 DEM，整个河北战区（史思明与李光弼拉锯之地）的黄河天险位置全错，渡口、漕运与行军路线均失去依据。",
      "action": "本文件提供唐代故道折线与沿程河床高程，由 20_build_terrain.py 在高度场上重新刻蚀河道。"
    },
    {
      "target": "大运河（通济渠）",
      "issue": "隋唐大运河的通济渠、永济渠在宋元以后逐渐湮废，现代 DEM 与 OpenStreetMap 中均已不存在。",
      "impact": "通济渠是唐代漕运动脉，江淮财赋经此输往洛阳、长安。缺失则「睢阳保卫战为何关系唐室存亡」在地图上无法体现。",
      "action": "本文件按考据补全四段运河（通济渠、邗沟、江南河、永济渠）的折线与河床高程。"
    }
  ],
